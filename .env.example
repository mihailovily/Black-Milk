# Public pages and builds work without these settings. Authentication needs PostgreSQL.
# Prefer pnpm setup:local to create .env.local with random local secrets.
POSTGRES_PASSWORD=replace-with-a-random-local-password
DATABASE_URL=postgresql://black_and_milk:replace-with-a-random-local-password@127.0.0.1:5432/black_and_milk
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Local mail capture only. Mailpit does not deliver to real inboxes.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=Black&Milk <journal@blackmilk.test>
# Future external SMTP configuration:
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASSWORD=

# Optional Google login. Configure the exact callback in Google Cloud.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Tests only; must name a disposable database ending in _tests.
# TEST_DATABASE_URL=postgresql://postgres:local-test-password@127.0.0.1:5432/black_milk_tests
